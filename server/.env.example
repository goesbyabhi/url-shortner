# All values have sensible defaults for local development (docker compose up).
# Copy to server/.env to override.

# PORT=3000
# BASE_URL=http://localhost:3000

# PGHOST=localhost
# PGPORT=5432
# PGUSER=shortener
# PGPASSWORD=shortener
# PGDATABASE=shortener
# PGSSL=true                 # required by hosted postgres (neon, supabase, …)

# CORS_ORIGIN=http://localhost:5173,https://your-pages-domain.pages.dev
# "*" allows any origin

# REDIS_URL=redis://localhost:6379
# upstash: rediss://… (TLS)

# CODE_LENGTH=7
# CACHE_TTL_SEC=86400
# RATE_LIMIT_MAX=30
# SWEEP_INTERVAL_MS=300000
